# ============================================================
# local_life_agent 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入你的真实密钥:
#   cp .env.example .env
#
# 安全提醒: .env 已加入 .gitignore 和 .dockerignore，不会被提交或打包进镜像

# --- LLM API 配置 ---

# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen (通义千问) API Key（在 https://dashscope.aliyun.com 获取）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型（可选: deepseek-v4-pro / deepseek-v4 / qwen-max / qwen-plus）
DEFAULT_MODEL=deepseek-v4-pro

# --- 模型分级路由 ---
# 快速模型：用于分析、分类、安全审查等轻量任务
FAST_MODEL=qwen-turbo
FAST_API_KEY=your_fast_api_key_here
FAST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 搜索工具配置 ---
# SerpAPI / Bing / 自定义搜索引擎的 API Key
SEARCH_API_KEY=your_search_api_key_here

# --- 高德地图 API ---
# 前往 https://lbs.amap.com/ 注册 → 创建应用 → 添加 Key（Web服务）
AMAP_API_KEY=your_amap_api_key_here

# 高德地图 JS API v2.0 安全密钥（可选）
AMAP_JS_SECURITY_CODE=

# 默认搜索城市
DEFAULT_CITY=北京

# --- 日志与追踪 ---
LOG_LEVEL=INFO
TRACE_ENABLED=true

# --- 高级配置（通常无需修改）---
# Web UI 端口
# WEBUI_SERVER_PORT=7860
# WEBUI_SERVER_NAME=0.0.0.0
# WEBUI_CONCURRENCY_LIMIT=3

# 工作流参数
# MAX_WINDOW_MESSAGES=30
# STREAM_HEARTBEAT_INTERVAL=2.5
# SAFETY_HEARTBEAT_INTERVAL=0.5

# LLM 参数
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# Trace 日志保留数量
# TRACE_MAX_COUNT=100
